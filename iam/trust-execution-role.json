{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCodeBuildAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/TerraformCodeBuildRole"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "terraform-pipeline-PROJECT_NAME"
        }
      }
    }
  ]
}
